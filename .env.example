# Environment variables for Trace. Copy to .env.local and fill in values.
# Names and comments only: never commit real values.

# --- Browser-safe Supabase configuration ---
# Supabase project API URL.
NEXT_PUBLIC_SUPABASE_URL=
# Supabase publishable/anon key; safe for browsers, protected by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public origin of this deployment (no trailing slash); used for links in emails.
NEXT_PUBLIC_APP_URL=

# --- Release behavior ---
# Server-only, non-secret. Set true for the public read-only reviewer demo.
TENDER_DEMO_MODE=

# --- Server-only secrets ---
# Supabase service-role key; used only by the privileged PDF and email-outbox writers.
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret that signs the Next.js to Edge broker envelope (same value as the Edge secret).
TENDER_EDGE_BROKER_TRANSPORT_SECRET=
# Key that encrypts the short-lived recipient session cookie.
TENDER_PUBLIC_SESSION_ENCRYPTION_KEY=

# --- Email outbox ---
# Mail provider: resend (production) or smtp (local; the default outside production).
TRACE_MAIL_PROVIDER=
# Sender address on a domain verified with the mail provider.
TRACE_MAIL_FROM=
# Resend API key (required when TRACE_MAIL_PROVIDER=resend).
TRACE_RESEND_API_KEY=
# Bearer secret (at least 32 random characters) for POST /api/outbox/drain.
TRACE_OUTBOX_DRAIN_SECRET=
# Local SMTP catcher host and port (smtp provider only; defaults 127.0.0.1 and 54325).
TRACE_MAIL_SMTP_HOST=
TRACE_MAIL_SMTP_PORT=

# --- Supabase Edge function secrets (set with `supabase secrets set`, not read by Next.js) ---
# HMAC key for the public broker rate limiter.
PUBLIC_BROKER_RATE_LIMIT_HMAC_SECRET=

# --- Scripts only (not read by the app at runtime) ---
# Direct Postgres URL, used by operator scripts only.
SUPABASE_DB_URL=
# Cloud demo seeding guards (see docs/DEMO_DATA.md).
TENDER_DEMO_PROJECT_REF=
TENDER_DEMO_USER_ID=
TENDER_DEMO_CONFIRM_PROJECT_REF=
